{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@chronos/core": ["packages/core/src"],
      "@chronos/api": ["packages/api/src"],
      "@chronos/worker": ["packages/worker/src"],
      "@chronos/scheduler": ["packages/scheduler/src"],
      "@chronos/cli": ["packages/cli/src"],
      "@chronos/dashboard": ["packages/dashboard/src"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**"]
}